{
  "crons": [{ "path": "/api/v1/maintenance/daily", "schedule": "0 3 * * *" }],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{artifacts/**,src/**,backend/**,configs/**,cardiovanta_ml/**}"
    }
  }
}
