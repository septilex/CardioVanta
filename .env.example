# Project Configuration
# Add non-sensitive config variables here

# Environment
ENVIRONMENT=production

# Backend settings
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Frontend settings
NEXT_PUBLIC_API_BASE_URL=https://api.your-backend-domain.com

# Model registry (R2/R3): the served model is pinned EXPLICITLY by ID and exact version.
# There is no "latest" fallback; an unregistered ID/version makes startup fail.
MODEL_ID=cardiovanta-lr13
MODEL_VERSION=1.0.0
# Optional absolute override; defaults to <project root>/artifacts.
# MODEL_REGISTRY_ROOT=/var/task/artifacts
