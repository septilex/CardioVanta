# Project configuration. Copy to .env (gitignored) for local development; in production set these in the
# Vercel project's Environment Variables. Check what is configured, without printing secrets:
#   python -m backend.app.core.config

# Environment
ENVIRONMENT=production

# Backend settings
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Frontend settings
NEXT_PUBLIC_API_BASE_URL=https://api.your-backend-domain.com

# Model registry (R2/R3): the served model is pinned EXPLICITLY by ID and exact version.
# There is no "latest" fallback; an unregistered ID/version makes startup fail.
MODEL_ID=cardiovanta-lr13
MODEL_VERSION=1.1.1
# Optional absolute override; defaults to <project root>/artifacts.
# MODEL_REGISTRY_ROOT=/var/task/artifacts

# --- Secrets -----------------------------------------------------------------------------------------------
# Leave empty here; never commit real values. Put them in .env locally and in Vercel for deployments.
# They are read as SecretStr (masked in logs and errors) and are optional: prediction serving needs neither.
# Never prefix a secret with NEXT_PUBLIC_, which would copy it into the browser bundle.
# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# MongoDB connection string, e.g. mongodb+srv://USER:PASSWORD@CLUSTER/DBNAME
MONGODB_URI=

# Optional external explanation service: enable only after privacy review. Backend only.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Generate a random backend-only key with at least 32 bytes; never commit it.
AI_SIGNING_KEY=
# Persistent local SQLite path shared by all backend workers (required).
AI_USAGE_DB=
AI_DAILY_LIMIT=50
AI_MINUTE_LIMIT=5
## Optional research workspace — all integrations remain disabled by default.
AUTH_ENABLED=false
REDIS_URL=
JWT_SIGNING_KEY=
JWT_ISSUER=cardiovanta
JWT_AUDIENCE=cardiovanta-research
ACCESS_TOKEN_SECONDS=600
REFRESH_TOKEN_SECONDS=604800
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=
REALTIME_ENABLED=false
RESEARCH_CACHE_TTL=300
# Anonymous rate limits key on the client address. Set this ONLY when the edge in front of the API overwrites the
# header with the real client address: x-real-ip on Vercel. Leave it empty behind the Docker Compose Next.js proxy,
# which forwards a client-supplied X-Forwarded-For unchanged (anyone could then pick their own rate-limit bucket).
CLIENT_IP_HEADER=

# Server-only origin of the FastAPI backend as seen from the Next.js server; enables request-time rendering of
# /research/evaluations. Docker Compose sets http://backend:8000. On Vercel use the deployment's https origin.
RESEARCH_API_ORIGIN=
